{
  "name": "@workspace/worky-mobile",
  "version": "0.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "mkdir -p \"$HOME/.expo\" && sh -c 'if [ -n \"$REPLIT_EXPO_SESSION_SECRET\" ]; then pnpm exec create-launch login --session \"$REPLIT_EXPO_SESSION_SECRET\" || true; fi' && EXPO_PACKAGER_PROXY_URL=https://$REPLIT_EXPO_DEV_DOMAIN EXPO_PUBLIC_DOMAIN=$REPLIT_DEV_DOMAIN EXPO_PUBLIC_REPL_ID=$REPL_ID REACT_NATIVE_PACKAGER_HOSTNAME=$REPLIT_DEV_DOMAIN pnpm exec expo start --localhost --port $PORT",
    "build": "node scripts/build.js",
    "serve": "node server/serve.js",
    "build:apk": "node scripts/build-android-apk.mjs",
    "test:conversations": "../api-server/node_modules/.bin/tsx --test test/conversations.test.mjs test/chat-attachments.test.mjs test/chat-timeline.test.mjs test/job-navigation.test.mjs",
    "test:password-change": "../api-server/node_modules/.bin/tsx --test test/password-change.test.mjs",
    "test:login-errors": "../api-server/node_modules/.bin/tsx --test test/login-errors.test.mjs",
    "test:session-validation": "../api-server/node_modules/.bin/tsx --test test/session-validation.test.mjs",
    "test:profile-save": "../api-server/node_modules/.bin/tsx --test test/personal-details-save.test.mjs test/professional-profile-save.test.mjs",
    "test:role-switch-web-browser": "node --test test/role-switch-web.browser.test.mjs",
    "test:tabs-safe-area": "node --test test/tabs-safe-area.browser.test.mjs",
    "test:android-status-bar": "node --test test/android-status-bar.test.mjs",
    "test:android-status-bar:native": "WORKY_ANDROID_STATUS_BAR_NATIVE=1 node --test test/android-status-bar.test.mjs",
    "test:mobile-visual": "pnpm run test:android-status-bar:native && pnpm run test:tabs-safe-area",
    "test:jobs-role-access": "node --test test/jobs-role-access.browser.test.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@expo-google-fonts/dm-sans": "^0.4.2",
    "@expo-google-fonts/inter": "^0.4.0",
    "@expo-google-fonts/space-grotesk": "^0.4.1",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native/metro-config": "0.88.0",
    "@stardazed/streams-text-encoding": "^1.0.2",
    "@tanstack/react-query": "catalog:",
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.3.0",
    "@ungap/structured-clone": "^1.3.0",
    "@workspace/api-client-react": "workspace:*",
    "@workspace/worky-domain": "workspace:*",
    "babel-plugin-react-compiler": "^19.0.0-beta-e993439-20250117",
    "create-launch": "0.3.6",
    "expo-blur": "~58.0.6",
    "expo-constants": "~58.0.16",
    "expo-font": "~58.0.12",
    "expo-glass-effect": "~58.0.5",
    "expo-haptics": "~58.0.8",
    "expo-image": "~58.0.18",
    "expo-image-picker": "~58.0.10",
    "expo-linear-gradient": "~58.0.4",
    "expo-linking": "~58.0.17",
    "expo-location": "~58.0.22",
    "expo-router": "~58.0.31",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "expo-symbols": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "expo-web-browser": "~58.0.8",
    "playwright": "^1.62.1",
    "pngjs": "7.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-keyboard-controller": "1.22.7",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0",
    "typescript": "~6.0.3",
    "zod": "catalog:",
    "zod-validation-error": "^3.4.0"
  },
  "dependencies": {
    "expo": "~58.0.25",
    "expo-file-system": "~58.0.13",
    "react": "19.3.0",
    "react-native": "0.88.1"
  }
}
