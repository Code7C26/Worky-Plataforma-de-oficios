modules = ["nodejs-24", "python-base-3.13", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.build]
args = ["pnpm", "run", "build:worky"]
env = { "CI" = "true" }

[deployment.postBuild]
args = ["bash", "scripts/prepare-deployment-runtime.sh"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "worky"

[[workflows.workflow]]
name = "worky"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm run validate:worky"

[workflows.workflow.metadata]
isValidation = true

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 120000

[nix]
channel = "stable-25_05"
packages = ["alsa-lib", "atk", "cmake", "cups", "dbus", "expat", "fontconfig", "freetype", "gdk-pixbuf", "glib", "gtk3", "jdk17", "libgbm", "libsndfile", "libxkbcommon", "ninja", "nspr", "nss", "pango", "patchelf", "unzip", "xorg.libX11", "xorg.libXcomposite", "xorg.libXdamage", "xorg.libXext", "xorg.libXfixes", "xorg.libXrandr", "xorg.libxcb", "xorg.libxshmfence"]

[objectStorage]
defaultBucketID = "replit-objstore-29e3169f-edfe-4d69-96a3-6b526b73cb71"

[userenv]

[userenv.production]
RESEND_FROM_EMAIL = "no-reply@worky.devs.surf"
WORKY_ADMIN_SIGNUP_ALLOWED_EMAILS = "mateovillarreal1809@gmail.com"
WORKY_ADMIN_GMAIL_USER = "santiagoromero705@gmail.com"

[userenv.shared]

[userenv.development]
WORKY_ADMIN_GMAIL_USER = "mateovillarreal1809@gmail.com"
WORKY_ADMIN_SIGNUP_ALLOWED_EMAILS = "mateovillarreal1809@gmail.com,santiromero705@gmail.com"
