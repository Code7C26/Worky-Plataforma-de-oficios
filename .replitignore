# The format of this file is identical to `.dockerignore`.
# It is used to reduce the size of deployed images to make the process of publishing faster.

# No need to store the pnpm store twice.
.local
/generated-artifacts/
# Development caches and Python support files are not used at runtime.
/.cache/
/.pythonlibs/
/.git/
/artifacts/worky-mobile/static-build/
/artifacts/worky-mobile/android/
/artifacts/worky-mobile/test-results/android-status-bar/
/artifacts/worky-publicidad-vertical/hyperframes/renders/
